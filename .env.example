# Vorlage. Echte Werte NIE ins Repo. Eintragen in Netlify:
# Project configuration -> Environment variables (Scope: Functions)

# --- Stripe (zuerst Testmodus: sk_test_..., whsec_...) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Erst auf true setzen, wenn echte Zahlungen freigegeben sind (Live-Key)
ALLOW_LIVE_PAYMENTS=false

# --- Gelato ---
GELATO_API_KEY=xxx
# draft = nur Entwürfe (nichts wird gedruckt/verrechnet); order = echt
GELATO_ORDER_TYPE=draft
# JSON: Schlüssel "format:rahmen" bzw. "format" -> Gelato productUid
GELATO_PRODUCT_UIDS={"30x40-rahmen:natur":"...","30x40-rahmen:schwarz":"...","30x40-rahmen:weiss":"...","50x70-poster":"..."}
# Optional, sonst Gelato-Standard
GELATO_SHIPMENT_METHOD=
# Frei gewählter langer Zufallswert, gleich im Gelato-Webhook als Header x-webhook-secret
GELATO_WEBHOOK_SECRET=xxx

# --- Brevo (Transaktionsmails) ---
BREVO_API_KEY=xkeysib-xxx
BREVO_SENDER_EMAIL=bestellung@meinherzort.ch
BREVO_SENDER_NAME=meinherzort
SUPPORT_EMAIL=hallo@meinherzort.ch
# Optional: Kopie aller Kundenmails
MAIL_BCC=

# --- Handy-Benachrichtigung (ntfy) ---
# Langes, nicht erratbares Thema, z.B. meinherzort-7f3k9q2xw (in der ntfy-App abonnieren)
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=

# --- Interne Geheimnisse (je ein langer Zufallswert, z.B. `openssl rand -hex 32`) ---
ADMIN_TOKEN=
INTERNAL_SECRET=
FILE_URL_SECRET=

# Öffentliche Adresse (Netlify setzt URL automatisch; nur für eigene Domain nötig)
PUBLIC_SITE_URL=https://meinherzort.ch
